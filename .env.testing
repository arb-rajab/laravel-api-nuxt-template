APP_NAME=starter_app
APP_ENV=testing
# Throwaway key generated for this template; it protects nothing.
APP_KEY=base64:ywv1iPcIe2vMHE99SKe/3FBX1W30gxkXVnWUzxAu5QY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Tests run against real Postgres (never SQLite) in a dedicated database, never
# the local dev one.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_app_test
DB_USERNAME=starter_app_app
DB_PASSWORD=starter_app_app_local_only

DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=starter_app_test
DB_MIGRATOR_USERNAME=starter_app_migrator
DB_MIGRATOR_PASSWORD=starter_app_migrator_local_only

# 'array' keeps the fast gate free of a Redis dependency. Within one Pest test
# the testing HTTP client reuses one app instance, so the array store persists
# exactly as long as a login + follow-up request needs.
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# Matches a Feature test's Origin header: Sanctum only applies the
# session/CSRF middleware group to requests presenting one of these.
FRONTEND_URLS=http://localhost,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# sync/array so the fast gate never needs Redis or RabbitMQ. The one suite that
# needs the real broker (composer test:queue-broker) switches this at runtime.
QUEUE_CONNECTION=sync
CACHE_STORE=array

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=starter_app
RABBITMQ_PASSWORD=starter_app_rabbitmq_local_only
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=starter_app_test

MAIL_MAILER=array
