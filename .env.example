APP_NAME=starter_app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime connection: the ONLY role the running application authenticates as.
# An ordinary role, fully subject to row level security.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_app
DB_USERNAME=starter_app_app
DB_PASSWORD=starter_app_app_local_only

# Migrator connection: owns the tables and holds BYPASSRLS. Used only for
# migrations, seeders and backfills, never by the running application. Keep
# this credential out of the application's ordinary runtime secrets.
DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=starter_app
DB_MIGRATOR_USERNAME=starter_app_migrator
DB_MIGRATOR_PASSWORD=starter_app_migrator_local_only

# Sanctum SPA (stateful/cookie) auth needs a persisted session store.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The Nuxt frontend's origin(s). FRONTEND_URLS carries full origins (scheme +
# host[:port]) for CORS; SANCTUM_STATEFUL_DOMAINS carries host[:port] only.
# Use `localhost`, not `127.0.0.1`, for both the frontend and the API:
# cookies are scoped by hostname, so mixing them breaks the cookie flow.
FRONTEND_URLS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated proxy addresses/CIDRs whose X-Forwarded-* headers are
# trusted. Leave empty unless the app sits behind a reverse proxy; never '*'.
TRUSTED_PROXIES=

# Login rate limits (see config/rate_limiting.php).
# RATE_LIMIT_LOGIN_PER_CREDENTIAL_PER_MINUTE=10
# RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional RabbitMQ module. Without it, use QUEUE_CONNECTION=redis (or sync).
QUEUE_CONNECTION=rabbitmq
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=starter_app
RABBITMQ_PASSWORD=starter_app_rabbitmq_local_only
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=starter_app
# The management plugin's HTTP API, read by GET /api/queue-health.
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
