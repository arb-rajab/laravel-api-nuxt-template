# The Laravel API this app calls. The defaults already match the backend's own
# `php artisan serve` port, so local development needs no .env unless the API
# runs somewhere else. Use `localhost`, never `127.0.0.1`, for both the
# frontend and the API: cookies are scoped by hostname.
NUXT_PUBLIC_API_ORIGIN=http://localhost:8000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
# Set to false if the backend's optional tenancy module was removed.
NUXT_PUBLIC_TENANCY=true
