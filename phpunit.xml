<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Optional module: tenancy (delete together with app/Tenancy). -->
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
        <!-- Optional module: RabbitMQ. Needs a real broker; group queue-broker. -->
        <testsuite name="RabbitMq">
            <directory>tests/RabbitMq</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Tests run against real Postgres, never SQLite: row level
            security, the two-role setup and uuid defaults have no SQLite
            equivalent. Connection values come from .env.testing, which
            Laravel loads automatically for APP_ENV=testing.
        -->
        <env name="APP_ENV" value="testing"/>
    </php>
</phpunit>
